{
  "expo": {
    "name": "Spacia",
    "slug": "spacia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spacia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jhonmarcel.spacia"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/alarm.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123F1F",
          "image": "./assets/images/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a9855ca-d4fd-4747-a13a-dcf59e2c60e0"
      }
    },
    "owner": "marcelhahaha"
  }
}
